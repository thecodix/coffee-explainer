# Owner connection (migrations, loads, embeddings). Neon: Dashboard -> Connect -> connection string.
DATABASE_URL=postgresql://owner:password@ep-xxxx.eu-central-1.aws.neon.tech/explainer?sslmode=require

# Password for the API's read-only login role (python -m explainer_data create-reader explainer_api)
READER_PASSWORD=

# Tests only: a Postgres with pgvector where the tests may create and drop databases
TEST_ADMIN_URL=
